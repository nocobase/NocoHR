+import { defineAppRoutes } from '@nocobase/app-client/plugins';
+// NocoHR compatibility for plugins published before client 3 unified route contributions.
+function surfaceRoutes(routes, prefix) {
+    const map = (route, mounted = false) => ({
+        ...route,
+        auth: route.auth ?? 'required',
+        ...(route.path && !mounted && !route.parent ? { path: `${prefix}/${route.path.replace(/^\/+/, '')}` } : {}),
+        ...(prefix === '/dev' && route.componentLoader && route.authz == null ? { authz: 'skip' } : {}),
+        ...(route.children ? { children: route.children.map((child) => map(child, mounted || Boolean(route.path) || Boolean(route.parent))) } : {}),
+    });
+    return defineAppRoutes(routes.map((route) => map(route)));
+}
+export const defineSettingsRoutes = (routes) => surfaceRoutes(routes, '/settings');
+export const defineDevRoutes = (routes) => surfaceRoutes(import.meta.env?.PROD ? [] : routes, '/dev');
